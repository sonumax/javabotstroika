<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="013-fuel-machine-type" author="max">

        <!-- 1) справочник типов механизмов (для ветки MACHINES) -->
        <createTable tableName="fuel_machine_type">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="chat_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>

            <column name="name_norm" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>

            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="sort_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint tableName="fuel_machine_type"
                             columnNames="chat_id,name_norm"
                             constraintName="uk_fuel_machine_type_chat_name_norm"/>

        <createIndex tableName="fuel_machine_type" indexName="ix_fmt_chat">
            <column name="chat_id"/>
        </createIndex>

        <createIndex tableName="fuel_machine_type" indexName="ix_fmt_name_norm">
            <column name="name_norm"/>
        </createIndex>

        <createIndex tableName="fuel_machine_type" indexName="ix_fmt_active_sort">
            <column name="is_active"/>
            <column name="sort_order"/>
        </createIndex>


        <!-- 2) fuel_detail: equipment_id делаем nullable + добавляем machine_type_id -->
        <dropNotNullConstraint tableName="fuel_detail"
                               columnName="equipment_id"
                               columnDataType="BIGINT"/>

        <addColumn tableName="fuel_detail">
            <column name="machine_type_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="fuel_detail" baseColumnNames="machine_type_id"
                referencedTableName="fuel_machine_type" referencedColumnNames="id"
                constraintName="fk_fuel_detail_machine_type"/>

        <createIndex tableName="fuel_detail" indexName="ix_fuel_detail_machine_type">
            <column name="machine_type_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
